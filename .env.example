# Claude (https://console.anthropic.com) — or run `ant auth login` instead
ANTHROPIC_API_KEY=

# PayPal sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id for PAYMENT.CAPTURE.COMPLETED signature verification
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Public URL of this app (used for PayPal return URLs and MCP links)
APP_URL=http://localhost:3000
# Orders at or above this many cents are invoiced via PayPal Invoicing instead of checkout
INVOICE_THRESHOLD_CENTS=25000

# Base64 PKCS#8 Ed25519 key. Optional locally, required on Vercel
MANDATE_SIGNING_KEY=

# Production only. Local runs use data/shelfie.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
